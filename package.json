{
  "name": "rakugaction",
  "private": true,
  "version": "0.15.2",
  "description": "ラクガキから生まれた自分だけのキャラクターで遊ぶ3Dアクションゲーム",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "preview:pages": "node scripts/serve-subpath.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
